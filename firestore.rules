rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.email == 'nexusplatformafrica@gmail.com'; }

    // Rounds: everyone reads the live table, signed-in clients drive the engine.
    match /rounds/{roundId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();

      match /bets/{betId} {
        allow read: if true;
        allow create, update: if isSignedIn();
        allow delete: if isAdmin();
      }
    }

    // Public player card, but only the owner (or the server) may change it.
    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    match /chat/{messageId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Integrations hold HMAC secrets: admin console only, plus the server
    // (Admin SDK) which bypasses these rules.
    match /operators/{slug} {
      allow read, write: if isAdmin();
    }

    // Written exclusively by the server via the Admin SDK.
    match /operator_sessions/{id} { allow read, write: if false; }
    match /wallet_transfers/{id}  { allow read, write: if false; }
  }
}
